# Copy this file to .env (same folder) and fill it in. .env is git-ignored. Keep it private.

# ---------------------------------------------------------------- AI's Telegram account
# The second Telegram account you registered with your own SIM. The PC signs into it.
# Get API_ID / API_HASH at https://my.telegram.org, logged in AS THE AI'S ACCOUNT,
# under "API development tools".
TG_API_ID=
TG_API_HASH=
TG_PHONE=+15551234567

# ---------------------------------------------------------------- who the AI listens to
# Your personal account's @username. The AI answers only you and the glasses.
OWNER=@your_username

# ---------------------------------------------------------------- glasses bot
# Make one with @BotFather (/newbot). The token goes onto the board. The glasses only
# obey the AI account, and only inside the group Loupe creates.
GLASSES_BOT_TOKEN=
GROUP_TITLE=Loupe

# ---------------------------------------------------------------- local model (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
# Blank = pick the best model that fits this machine's GPU (qwen3-vl:8b on an RTX 4060).
MODEL=
# What the AI does with a button-press frame. Blank = the built-in prompt.
CAPTURE_PROMPT=

# ---------------------------------------------------------------- Gmail backup
# Each device has its own Gmail account. Both need 2-Step Verification and an
# App Password: https://myaccount.google.com/apppasswords
# If Telegram fails, the glasses email the frame from GLASSES_GMAIL to AI_GMAIL.
AI_GMAIL=
AI_GMAIL_APP_PASSWORD=
GLASSES_GMAIL=
GLASSES_GMAIL_APP_PASSWORD=
# Where the AI emails replies if its own Telegram is down.
OWNER_EMAIL=
GMAIL_POLL_SECONDS=60

DASHBOARD_PORT=8765
